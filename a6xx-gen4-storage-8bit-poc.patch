+        # PROOF OF CONCEPT (2026-11-25, local only, NOT for upstream):
+        # enable the a7xx 8-bit SSBO treatment on a6xx gen4 (660/662/663/
+        # 690/643). On a660, 8-bit SSBO loads/stores use the single R16
+        # descriptor via isam, so the hardware scales byte addresses x2
+        # (treats them as 16-bit indices) -- see the byte-exact self-test
+        # evidence (get_rows 3968/4096 wrong, set_rows 868/1088 wrong).
+        # Setting this flips all the coordinated sites together:
+        #  - an R8_UINT descriptor is allocated per storage buffer
+        #    (tu_descriptor_set.cc, tu_device.cc storageBufferDescriptorSize)
+        #  - 8-bit SSBO accesses are bumped to it (tu_shader.cc)
+        #  - 8-bit SSBO loads avoid isam for the ldib fallback
+        #    (ir3_compiler_nir.c) with max imm offset 127
+        #    (ir3_nir_lower_io_offsets.c).
+        # SIDE EFFECT: this also advertises VK_KHR_8bit_storage (and the
+        # 8-bit storage features) on these chips. The proper upstream fix
+        # would split the SSBO-descriptor handling from the advertised
+        # feature; for a local PoC this is acceptable (PocketPal uses
+        # SSBOs, not 8-bit uniforms/push constants).
+        storage_8bit = True,
         has_tex_filter_cubic = True,
         has_separate_chroma_filter = True,
         has_sample_locations = True,
